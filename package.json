{
  "name": "logomarks",
  "version": "0.1.0",
  "description": "Check logomarks the way the Logomarks set is checked (fit, specks, pin-holes, slivers, clipping, gaps, 32 px features, the nearest of 1,400+ live marks, review sheets), then build a brand on one: the mark's files, a free starter kit (favicons, lockups, palette, social images, brand sheet), mockups and covers. Pure JS, resvg in WebAssembly.",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "bin": {
    "logomarks": "bin/logomarks.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "data",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "index": "node scripts/index.js"
  },
  "keywords": [
    "logo",
    "logomark",
    "logomarks",
    "brand",
    "svg",
    "lint",
    "check",
    "favicon",
    "duplicate",
    "design-review",
    "ai",
    "claude-code",
    "cli",
    "brand-kit",
    "favicon-generator",
    "mockup",
    "cover",
    "og-image",
    "palette"
  ],
  "author": "David Sherlock",
  "license": "MIT",
  "homepage": "https://logomarks.ai",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@arraypress/covers": "^1.1.0",
    "@arraypress/mockups": "^0.1.1",
    "@resvg/resvg-wasm": "2.6.2",
    "polygon-clipping": "^0.15.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3"
  }
}
