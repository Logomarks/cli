{
  "name": "logomarks",
  "version": "0.2.0",
  "description": "Check logomarks the way the Logomarks set is checked (fit, specks, pin-holes, slivers, clipping, gaps, 32 px features, the nearest of 2,000+ live marks, review sheets), edit them (glitch editions, edits by part, combining two), then build a brand on one: the mark's files, a brand kit (favicons, lockups, palette, tokens, brand sheet), a social pack for every platform, mockups and covers. Also an MCP server for Claude Code, Codex and Cursor. Pure JS, resvg in WebAssembly.",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "bin": {
    "logomarks": "bin/logomarks.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./mcp": {
      "types": "./src/mcp/index.d.ts",
      "import": "./src/mcp/index.js",
      "default": "./src/mcp/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "data",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "index": "node scripts/index.js"
  },
  "keywords": [
    "logo",
    "logomark",
    "logomarks",
    "brand",
    "svg",
    "lint",
    "check",
    "favicon",
    "duplicate",
    "design-review",
    "ai",
    "claude-code",
    "cli",
    "brand-kit",
    "favicon-generator",
    "mockup",
    "cover",
    "og-image",
    "palette",
    "social-media",
    "glitch",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "codex"
  ],
  "author": "David Sherlock",
  "license": "MIT",
  "homepage": "https://logomarks.ai",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@logomarks/brand-kit": "^0.3.1",
    "@arraypress/color-utils": "^1.4.0",
    "@arraypress/covers": "^1.3.0",
    "@logomarks/core": "^0.1.2",
    "@logomarks/mockups": "^0.4.3",
    "@arraypress/search": "^0.1.0",
    "@logomarks/vector-editor": "^0.2.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@resvg/resvg-wasm": "2.6.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3"
  }
}
