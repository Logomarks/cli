{
  "name": "logomarks",
  "version": "0.2.0",
  "description": "Find, check, edit and build on free geometric logomarks from the command line or an AI agent: search the CC0 Logomarks set, check marks against its house rules, edit and glitch them, and build a brand kit, social pack, mockups and covers. Includes an MCP server.",
  "keywords": [
    "logo",
    "logomark",
    "logomarks",
    "brand",
    "brand-kit",
    "svg",
    "favicon",
    "icon",
    "mockup",
    "og-image",
    "social-media",
    "design",
    "cli",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "codex",
    "cursor",
    "cc0"
  ],
  "homepage": "https://logomarks.ai",
  "bugs": {
    "url": "https://github.com/Logomarks/skills/issues"
  },
  "license": "MIT",
  "author": {
    "name": "David Sherlock",
    "url": "https://davidsherlock.com"
  },
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "bin": {
    "logomarks": "bin/logomarks.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./mcp": {
      "types": "./src/mcp/index.d.ts",
      "import": "./src/mcp/index.js",
      "default": "./src/mcp/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "data",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "index": "node scripts/index.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@logomarks/brand-kit": "^0.4.1",
    "@arraypress/color-utils": "^1.5.0",
    "@arraypress/covers": "^1.3.1",
    "@logomarks/core": "^0.1.3",
    "@logomarks/mockups": "^0.5.0",
    "@arraypress/search": "^0.1.0",
    "@logomarks/editor": "^0.2.4",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@resvg/resvg-wasm": "2.6.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3"
  }
}
